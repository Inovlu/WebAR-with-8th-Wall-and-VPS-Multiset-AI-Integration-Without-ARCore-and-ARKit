VITE_MULTISET_CLIENT_ID=
VITE_MULTISET_CLIENT_SECRET=
VITE_MAP_CODE=

# Manual fallback: if the map is not yet georeferenced in the MultiSet
# dashboard (GET /vps/map/{code} returns location: undefined), fill in
# the real lat/lon of the location so the proximity check in
# src/main.js works. Once the map is georeferenced from the dashboard,
# these two lines are no longer needed.
VITE_MAP_LATITUDE=
VITE_MAP_LONGITUDE=

# Optional — "vps-1" (standard, default if omitted) or "vps-2" (deep
# search, slower/more expensive). Only change if vps-1 does not
# relocalize well on this particular map.
VITE_MULTISET_QUERY_MODE=

# Optional — "true" to use /vps/map/multi-image-query (sends 4 photos
# in burst per request) instead of /vps/map/query-form (1 photo).
# Toggle via flag without touching code to compare which relocalizes
# better on this particular map.
VITE_MULTISET_USE_MULTI_IMAGE=

# Optional — milliseconds to wait between each of the 4 photos in
# multi-image mode (default 200). Gives the camera feed time to
# produce a new frame between captures (otherwise two consecutive
# captures may be identical) and margin for the user to slightly
# move the phone.
VITE_MULTISET_MULTI_IMAGE_DELAY_MS=

# Optional — seconds between automatic background relocalizations
# after the initial manual tap (range 10-180, default 30).
VITE_MULTISET_BG_INTERVAL_SECONDS=

# Optional — minimum confidence (0.2-0.8, default 0.5) to accept
# an automatic background relocalization. Threshold is higher than
# for a manual tap so a good position isn't replaced by a worse one
# from a relocalization where the user isn't deliberately pointing
# the camera.
VITE_MULTISET_CONFIDENCE_THRESHOLD=

# Optional — maximum distance in meters between the user and the
# map to allow a relocalization attempt (default 150). Best-effort
# client-side check; the actual matching is validated by MultiSet
# against the image.
VITE_MAX_DISTANCE_METERS=

# If the MultiSet REST endpoint doesn't yet have the ngrok domain
# approved (gives CORS error), set this to "true" to simulate
# responses without making real network calls — this way you can
# keep testing the rest of the flow (frame capture,
# updateCameraProjectionMatrix) without being blocked.
VITE_MULTISET_MOCK=false
