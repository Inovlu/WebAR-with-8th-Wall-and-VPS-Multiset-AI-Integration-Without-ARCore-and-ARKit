VITE_MULTISET_CLIENT_ID=
VITE_MULTISET_CLIENT_SECRET=
VITE_MAP_CODE=

# Fallback manual: si el mapa no está georeferenciado en el dashboard de
# MultiSet todavía (GET /vps/map/{code} devuelve location: undefined),
# completá con la lat/lon real del lugar para que funcione el chequeo de
# proximidad en src/main.js. Una vez georeferenciado el mapa desde el
# dashboard, estas dos líneas dejan de ser necesarias.
VITE_MAP_LATITUDE=
VITE_MAP_LONGITUDE=

# Opcional — "vps-1" (estándar, default si se omite) o "vps-2" (búsqueda
# profunda, más lenta/costosa). Solo tocar si vps-1 no relocaliza bien en
# este mapa puntual.
VITE_MULTISET_QUERY_MODE=

# Opcional — "true" para usar /vps/map/multi-image-query (manda 4 fotos en
# ráfaga por request) en vez de /vps/map/query-form (1 foto). Alternativa
# vía flag, no reemplaza el flujo de 1 imagen — podés cambiar sin tocar
# código para comparar cuál relocaliza mejor en este mapa puntual.
VITE_MULTISET_USE_MULTI_IMAGE=

# Opcional — milisegundos de espera entre cada una de las 4 fotos del modo
# multi-imagen (default 200). Le da tiempo al feed de cámara a mostrar un
# frame nuevo entre toma y toma (si no, dos capturas seguidas pueden salir
# idénticas) y margen para que el usuario mueva apenas el teléfono.
VITE_MULTISET_MULTI_IMAGE_DELAY_MS=

# Opcional — segundos entre relocalizaciones automáticas en background,
# tras el tap manual inicial (rango 10-180, default 30).
VITE_MULTISET_BG_INTERVAL_SECONDS=

# Opcional — confianza mínima (0.2-0.8, default 0.5) para aceptar una
# relocalización automática en background. Umbral más alto que el del tap
# manual para no reemplazar una posición buena por una peor en una
# relocalización sin usuario apuntando deliberadamente la cámara.
VITE_MULTISET_CONFIDENCE_THRESHOLD=

# Opcional — milisegundos de suavizado al aplicar una corrección de pose
# (default 400). updateCameraProjectionMatrix() no tiene transición nativa;
# esto evita que el salto se vea como un "teletransporte" duro.
VITE_CORRECTION_SMOOTHING_MS=

# Opcional — distancia máxima en metros entre el usuario y el mapa para
# permitir el intento de relocalización (default 150). Chequeo best-effort
# del lado del cliente; la coincidencia real la valida MultiSet contra la
# imagen.
VITE_MAX_DISTANCE_METERS=

# Si el endpoint REST de MultiSet todavía no tiene el dominio de ngrok
# aprobado (da error de CORS), poné esto en "true" para simular respuestas
# sin llamar a la red de verdad — así se puede seguir probando el resto del
# flujo (captura de frame, updateCameraProjectionMatrix) sin bloquearse.
VITE_MULTISET_MOCK=false
